# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Any random string; used to hash submitter IPs for rate limiting (raw IPs are never stored).
IP_HASH_SALT=change-me

# Only needed on the deployed site, for the daily App Store version check (vercel.json).
# Keep both secret: never prefix them with NEXT_PUBLIC_.
CRON_SECRET=
SUPABASE_SECRET_KEY=
